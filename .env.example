# Copy this file to .env.local and fill in real values.
# Never commit real secrets. These stay server-side only (no NEXT_PUBLIC_ prefix).

# --- Public site URL (SEO: canonical, sitemap, Open Graph) ---
# The absolute origin visitors see, e.g. https://floza.vercel.app or your custom
# domain. Used for canonical links, sitemap.xml and the share preview image.
# When unset: Vercel's production URL is used automatically, otherwise
# https://floza.vercel.app (production) / http://localhost:3000 (dev).
NEXT_PUBLIC_SITE_URL=

# --- Database: Neon (serverless Postgres) ---
# Connection string from https://console.neon.tech → Connection Details →
# "Connection string" (the postgresql://... value, NOT the https:// project URL).
# It looks like: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Prefer the POOLED string (host contains -pooler) for serverless apps; you may drop
# `&channel_binding=require` if a driver rejects it.
# When unset or invalid, an in-memory fallback store is used for local development.
DATABASE_URL=

# --- Neon Storage: S3-compatible object storage (user uploads / document processing) ---
# Endpoint, key ID and secret from https://console.neon.tech -> Storage.
# Works with any S3 SDK (e.g. @aws-sdk/client-s3) by setting the endpoint, region,
# and forcing path-style addressing. Not yet used by the app — reserved for later phases.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Email notifications: SMTP (any provider — Gmail, Brevo, Mailgun, VPS mail) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS = the 16-char App Password from myaccount.google.com/apppasswords (no spaces),
# SMTP_FROM=your@gmail.com — leads then land in your own inbox.
# When unset, lead notifications are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# optional recipient; defaults to SMTP_FROM (your own address = lead notifications land in your inbox)
SMTP_TO=

# --- AI chatbot: OpenAI-compatible provider (OpenRouter / OpenAI / Groq) ---
# OpenRouter: key from https://openrouter.ai/keys, base URL https://openrouter.ai/api/v1
# When unset, the chatbot uses a built-in scripted fallback.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# --- Admin dashboard (/admin) ---
# Password that unlocks the private dashboard (docs/09_SECURITY_AND_PRIVACY.MD #8).
# Keep it strong and unguessable; leave empty to disable admin access.
ADMIN_SECRET=
